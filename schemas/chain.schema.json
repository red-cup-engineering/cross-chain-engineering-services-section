{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/schema/cross-chain/chain.schema.json",
  "title": "Tidepool cross-chain registry: one chain",
  "description": "One chain's identity, canonical contracts and cross-chain rails. Every leaf is a Cited value: the datum, the first-party URL it was read from, the date read, and (for addresses) the result of an on-chain check. A datum that was looked for and not found is null with a notFound reason; an address is never guessed.",
  "type": "object",
  "required": ["schemaVersion", "slug", "name", "family", "network", "caip2", "chainId", "nativeAsset", "rpc", "finality"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "family": { "enum": ["evm", "hive", "solana"] },
    "network": { "enum": ["mainnet", "testnet"] },
    "testnetOf": { "type": ["string", "null"], "description": "Slug of the mainnet this testnet shadows." },
    "caip2": { "$ref": "#/$defs/cited" },
    "chainId": { "$ref": "#/$defs/cited" },
    "nativeAsset": {
      "type": "object",
      "required": ["symbol", "decimals"],
      "additionalProperties": false,
      "properties": { "symbol": { "$ref": "#/$defs/cited" }, "decimals": { "$ref": "#/$defs/cited" } }
    },
    "secondaryAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "decimals"],
        "additionalProperties": false,
        "properties": { "symbol": { "$ref": "#/$defs/cited" }, "decimals": { "$ref": "#/$defs/cited" }, "note": { "type": "string" } }
      }
    },
    "usdc": {
      "type": "object",
      "description": "kind is native (issuer-minted by Circle, burnable by CCTP) or bridged (anything else). null kind means no USDC address was found.",
      "required": ["kind", "address", "decimals"],
      "additionalProperties": false,
      "properties": { "kind": { "$ref": "#/$defs/cited" }, "address": { "$ref": "#/$defs/citedAddress" }, "decimals": { "$ref": "#/$defs/cited" } }
    },
    "cctp": {
      "type": "object",
      "description": "Circle CCTP v2. domain is Circle's domain id, not a chain id.",
      "additionalProperties": false,
      "properties": {
        "domain": { "$ref": "#/$defs/cited" },
        "tokenMessengerV2": { "$ref": "#/$defs/citedAddress" },
        "tokenMinterV2": { "$ref": "#/$defs/citedAddress" },
        "messageTransmitterV2": { "$ref": "#/$defs/citedAddress" },
        "tokenMessengerMinterV2": { "$ref": "#/$defs/citedAddress" },
        "finality": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "fast": { "$ref": "#/$defs/cited" }, "standard": { "$ref": "#/$defs/cited" } }
        }
      }
    },
    "hyperlane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domainId": { "$ref": "#/$defs/cited" },
        "mailbox": { "$ref": "#/$defs/citedAddress" },
        "interchainGasPaymaster": { "$ref": "#/$defs/citedAddress" },
        "merkleTreeHook": { "$ref": "#/$defs/citedAddress" },
        "validatorAnnounce": { "$ref": "#/$defs/citedAddress" },
        "staticMessageIdMultisigIsmFactory": { "$ref": "#/$defs/citedAddress" },
        "staticAggregationIsmFactory": { "$ref": "#/$defs/citedAddress" },
        "domainRoutingIsmFactory": { "$ref": "#/$defs/citedAddress" }
      }
    },
    "layerzero": {
      "type": "object",
      "description": "LayerZero v2. eid is the endpoint id.",
      "additionalProperties": false,
      "properties": {
        "eid": { "$ref": "#/$defs/cited" },
        "stage": { "$ref": "#/$defs/cited" },
        "endpointV2": { "$ref": "#/$defs/citedAddress" },
        "sendUln302": { "$ref": "#/$defs/citedAddress" },
        "receiveUln302": { "$ref": "#/$defs/citedAddress" },
        "executor": { "$ref": "#/$defs/citedAddress" }
      }
    },
    "ccip": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "chainSelector": { "$ref": "#/$defs/cited" }, "router": { "$ref": "#/$defs/citedAddress" } }
    },
    "eas": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "eas": { "$ref": "#/$defs/citedAddress" }, "schemaRegistry": { "$ref": "#/$defs/citedAddress" } }
    },
    "safe": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "singleton": { "$ref": "#/$defs/citedAddress" }, "singletonL2": { "$ref": "#/$defs/citedAddress" }, "proxyFactory": { "$ref": "#/$defs/citedAddress" } }
    },
    "erc4337": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "entryPointV07": { "$ref": "#/$defs/citedAddress" }, "entryPointV08": { "$ref": "#/$defs/citedAddress" } }
    },
    "permit2": { "$ref": "#/$defs/citedAddress" },
    "multicall3": { "$ref": "#/$defs/citedAddress" },
    "create2": {
      "type": "object",
      "description": "Deterministic deployers. createX supports CREATE2 and CREATE3; arachnidProxy is the minimal CREATE2 proxy.",
      "additionalProperties": false,
      "properties": { "createX": { "$ref": "#/$defs/citedAddress" }, "arachnidProxy": { "$ref": "#/$defs/citedAddress" } }
    },
    "operations": { "type": "object" },
    "rpc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "source", "readAt"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "source": { "type": "string" },
          "readAt": { "$ref": "#/$defs/date" },
          "verification": { "$ref": "#/$defs/rpcVerification" }
        }
      }
    },
    "explorers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "source", "readAt"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "source": { "type": "string" }, "readAt": { "$ref": "#/$defs/date" } }
      }
    },
    "finality": {
      "type": "object",
      "required": ["notes"],
      "properties": {
        "blockTimeSeconds": { "$ref": "#/$defs/cited" },
        "hyperlaneReorgPeriodBlocks": { "$ref": "#/$defs/cited" },
        "irreversibleThresholdBps": { "$ref": "#/$defs/cited" },
        "measured": { "type": "object", "description": "Written by verify-chain-registry: live finalized-tag support and lag." },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source", "readAt"],
            "additionalProperties": false,
            "properties": { "text": { "type": "string" }, "source": { "type": "string" }, "readAt": { "$ref": "#/$defs/date" } }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "cited": {
      "type": "object",
      "required": ["value", "source", "readAt"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number", "boolean", "null"] },
        "source": { "type": "string", "minLength": 1, "description": "First-party URL (or file path) the value was read from." },
        "readAt": { "$ref": "#/$defs/date" },
        "note": { "type": "string" },
        "notFound": { "type": "string", "description": "Why value is null. Required when value is null." }
      },
      "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
      "then": { "required": ["notFound"] }
    },
    "citedAddress": {
      "type": "object",
      "required": ["value", "source", "readAt"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "null"], "pattern": "^(0x[0-9a-fA-F]{40}|[1-9A-HJ-NP-Za-km-z]{32,44})$" },
        "source": { "type": "string", "minLength": 1 },
        "readAt": { "$ref": "#/$defs/date" },
        "note": { "type": "string" },
        "notFound": { "type": "string" },
        "verification": { "$ref": "#/$defs/addressVerification" }
      },
      "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
      "then": { "required": ["notFound"] }
    },
    "rpcVerification": {
      "type": "object",
      "required": ["verifiedAt", "result"],
      "properties": {
        "verifiedAt": { "$ref": "#/$defs/date" },
        "result": { "enum": ["reachable", "unreachable", "wrong-chain"] },
        "latencyMs": { "type": "number" },
        "detail": { "type": "string" }
      }
    },
    "addressVerification": {
      "type": "object",
      "description": "On-chain check. method is eth_getCode (equivalent to cast code) for EVM or getAccountInfo for Solana. result verified means non-empty code/executable at the address; the optional probe records an extra read (e.g. symbol(), localDomain()) and whether it matched the registry.",
      "required": ["method", "verifiedAt", "result"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["eth_getCode", "getAccountInfo"] },
        "rpc": { "type": "string" },
        "block": { "type": ["integer", "null"] },
        "codeBytes": { "type": ["integer", "null"] },
        "verifiedAt": { "$ref": "#/$defs/date" },
        "result": { "enum": ["verified", "no-code", "unreachable"] },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "call": { "type": "string" },
            "returned": { "type": ["string", "number", "null"] },
            "matchesRegistry": { "type": "boolean" }
          }
        }
      }
    }
  }
}
